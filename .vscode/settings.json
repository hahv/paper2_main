{
    "files.exclude": {
        "*.aux": true,
        "*.bbl": true,
        "*.blg": true,
        "*.fls": true,
        "*.ini": true,
        "*.log": true,
        "*.out": true,
        "*.toc": true,
        "*.pdf": false,
        "**/.hg": true,
        "**/CVS": true,
        "**/.git": true,
        "**/.svn": true,
        "**/*.gz": true,
        "uv.lock": true,
        "**/.venv": true,
        "**/*.aux": true,
        "**/*.log": true,
        "**/*.out": true,
        "**/wandb": true,
        "tb/*.log": true,
        "**/.project": true,
        "**/.vscode": false,
        "*.synctex.gz": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "*.fdb_latexmk": true,
        "**/.classpath": true,
        "**/.settings": false,
        "**/__pycache__": true,
        "**/.ruff_cache": true,
        "*.synctex(busy)": true,
        "**/.factorypath": true,
        "~$zzpaper2.xlsx": true,
        "**/.pytest_cache": true,
        "**/.python-version": true,
        "**/mutagen.yml.lock": true,
        "**/~$_issue_track.xlsx": true,
        // "**/ruff.toml": true, // Python Linter
        // "**/.yamlfmt": true, // For yamlfmt - a YAML formatter
        "**/.commit-rules.md": true, // commit rules - for ai commit msg gen
        // "**/.markdownlint.yaml": true, // For markdownlint - a Markdown linter
    },
    "notebook.formatOnSave.enabled": true,
    // Disable the Python language server; using ty (Astral.sh) for faster linting and formatting
    "python.languageServer": "None",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
}