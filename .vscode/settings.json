{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".vscode": false,
        "*.aux": true,
        "*.bbl": true,
        "*.blg": true,
        "*.fdb_latexmk": true,
        "*.fls": true,
        "*.ini": true,
        "*.log": true,
        "*.out": true,
        "*.pdf": false,
        "*.synctex.gz": true,
        "*.synctex(busy)": true,
        "*.toc": true,
        "**/.classpath": true,
        "**/.factorypath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/CVS": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.vscode": true,
        "~$zzpaper2.xlsx": true,
        "zreport/~$available_dataset.xlsx": true,
        "**/.ruff_cache": true,
        "uv.lock": true,
        "**/.python-version": true,
        "**/wandb": true
    },
    "explorerExclude.backup": {},
    "notebook.formatOnSave.enabled": true,
    // Disable the Python language server; using ty (Astral.sh) for faster linting and formatting
    "python.languageServer": "None",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    }
}