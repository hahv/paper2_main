from halib import *
from typing import List
import os
from src.config import Config
from src.results.base_rs_proc import BaseRsProc

# Import your new classes
from src.viz.renderers import *
from src.viz.video_pipeline import VideoPipeline


class VideoRsProc(BaseRsProc):
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.outdir = os.path.abspath(cfg.get_outdir())
        self.pipelines: List[VideoPipeline] = []

    def before_video(self, video_path: str, **kwargs):
        if fs.is_dir(video_path):
            return

        fname = fs.get_file_name(video_path, split_file_ext=True)[0]
        fps = kwargs["fps"]
        frame_size = kwargs["frame_size"]

        self.pipelines = []

        # ==================================================
        # PIPELINE 1: Main RGB Video (The "Standard" Output)
        # ==================================================
        if self.cfg.inferCfg.save_video_results:
            rgb_path = os.path.join(self.outdir, f"{fname}_out.mp4")
            rgb_pipe = VideoPipeline(rgb_path, fps, frame_size)

            # 1. Always Add Text Info
            rgb_pipe.add_renderer(InfoTextRenderer())

            # 2. (Optional) Overlay Motion Grid on RGB?
            # Flexible: You can toggle this via config without changing code structure
            if self.cfg.inferCfg.get("overlay_mask_on_rgb", False):
                rgb_pipe.add_renderer(MotionGridRenderer())

            self.pipelines.append(rgb_pipe)

        # ==================================================
        # PIPELINE 2: Mask Video (The "Debug" Output)
        # ==================================================
        if self.cfg.inferCfg.get("save_mask_video", False):
            # Note: frame_size here matches input. If mask size differs,
            # you might need logic to resize or separate frame_size params.
            mask_path = os.path.join(self.outdir, f"{fname}_fg_mask.mp4")
            mask_pipe = VideoPipeline(mask_path, fps, frame_size)

            # 1. SOURCE CHANGE: Swap RGB frame for the FG Mask
            mask_pipe.add_renderer(MaskSourceRenderer())

            # 2. Draw Grid on the Mask
            mask_pipe.add_renderer(MotionGridRenderer())

            # 3. Draw Text Info on top
            mask_pipe.add_renderer(InfoTextRenderer())

            self.pipelines.append(mask_pipe)

    def handle_frame_results(self, frame_bgr, frame_rs_dict: dict):
        # 1. Prepare Context (Standardized Data)
        infer_rs = frame_rs_dict["infer_rs"]

        context = {
            "text_info": {
                "FPS": frame_rs_dict["fps"],
                "Frame": f"{frame_rs_dict['frame_idx']}/{frame_rs_dict['num_frames']}",
                # Add any other stats you want to visualize
            },
            "fg_mask_dict": infer_rs.get("fg_mask_dict", None),
        }

        # 2. Run all active pipelines
        for pipe in self.pipelines:
            # If a pipeline requires mask data but it's missing (e.g. non-temporal method),
            # the Renderers inside will handle it gracefully (return original frame or black).
            pipe.process_and_write(frame_bgr, context)

    def after_video(self, video_path: str, **kwargs):
        for pipe in self.pipelines:
            pipe.release()
        self.pipelines = []
